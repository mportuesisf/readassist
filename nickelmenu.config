# main menu
menu_item		:main		:Refresh		:nickel_setting :toggle: invert
	chain_always      						:nickel_setting :toggle: invert
menu_item		:main		:USB Connect	:nickel_misc	:force_usb_connection
menu_item 		:main    	:IP Address     :cmd_output     :500:/sbin/ifconfig | /usr/bin/awk '/inet addr/{print substr($2,6)}'
menu_item		:main 		:Sleep			:power 			:sleep
menu_item		:main 		:ShutDown		:power 			:shutdown
menu_item		:main		:Reboot			:power			:reboot

# in-book reader menu
menu_item		:reader		:Dark Mode		:nickel_setting	:toggle	:dark_mode
menu_item		:reader 	:Wifi On		:nickel_wifi 	:enable
menu_item		:reader 	:Wifi Off		:nickel_wifi 	:disable
menu_item		:reader		:Refresh		:nickel_setting :toggle: invert
	chain_always      						:nickel_setting :toggle: invert

# in-book selection menu
menu_item		:selection			:RA Basic 			:nickel_browser:modal:http://192.168.0.94:5000/readassist?req_type=translate&text={1|S|%}&lang=it
menu_item		:selection			:RA Full	:nickel_browser:modal:http://192.168.0.94:5000/readassist?req_type=translate&req_type=usage&req_type=synonyms&req_type=idioms&text={1|S|%}&lang=it
menu_item		:selection_search	:G Translate		:nickel_browser:modal:https://translate.google.com/m?sl=auto&tl=en&q={1||%}#
menu_item		:selection_search	:Search DuckDuckGo	:nickel_browser:modal:https://duckduckgo.com/?q={1|S|%}
